---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { news } from '../data/content';
import { site } from '../config';
import { type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = news[lang];
---

<Base lang={lang} title={c.title} description={c.description} route="news">
  <PageHero lang={lang} heading={c.heading} lead={c.lead} crumbs={[{ label: c.title }]} />

  <section class="section">
    <div class="container grid grid--2">
      {
        c.items.map((item) => (
          <article class="card card--accent news-item">
            <p class="meta">
              <time>{item.date}</time>
              <span aria-hidden="true">·</span>
              <span>{item.source}</span>
            </p>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
            {item.url && (
              <a class="text-link" href={item.url} target="_blank" rel="noopener">
                {c.read}
                <Icon name="external" />
              </a>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--mist">
    <div class="container media">
      <h2>{c.mediaHeading}</h2>
      <p>
        {c.mediaText} <a href={`mailto:${site.email}`} dir="ltr">{site.email}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .news-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .news-item h2 {
    font-size: 1.35rem;
  }

  .news-item p:not(.meta) {
    flex: 1;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--blue) !important;
  }

  .media h2 {
    font-size: 1.5rem;
    margin-block-end: 8px;
  }

  .media p {
    color: var(--muted);
  }
</style>
