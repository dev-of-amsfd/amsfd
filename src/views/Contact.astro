---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { contact } from '../data/content';
import { site } from '../config';
import { useUi } from '../i18n/ui';
import { type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = contact[lang];
const t = useUi(lang);
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&hl=${lang}&z=12&output=embed`;
---

<Base lang={lang} title={c.title} description={c.description} route="contact">
  <PageHero lang={lang} heading={c.heading} lead={c.lead} crumbs={[{ label: c.title }]} />

  <section class="section section--mist">
    <div class="container contact-grid">
      <ContactForm lang={lang} heading={c.formHeading} id="contact" />

      <aside class="details">
        <h2>{c.detailsHeading}</h2>
        <ul>
          <li>
            <span class="details__icon"><Icon name="mail" /></span>
            <div><span>{c.email}</span><a href={`mailto:${site.email}`} dir="ltr">{site.email}</a></div>
          </li>
          <li>
            <span class="details__icon"><Icon name="phone" /></span>
            <div><span>{c.phone}</span><a href={`tel:${site.phoneHref}`} dir="ltr">{site.phone}</a></div>
          </li>
          <li>
            <span class="details__icon"><Icon name="pin" /></span>
            <div><span>{c.address}</span><strong>{t.footer.location}</strong></div>
          </li>
          <li>
            <span class="details__icon"><Icon name="clock" /></span>
            <div><span>{c.hours}</span><strong>{c.hoursValue}</strong></div>
          </li>
        </ul>
        <iframe class="map" title={c.mapTitle} src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact-grid {
    display: grid;
    gap: 28px;
    align-items: start;
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .details {
    padding: clamp(24px, 3vw, 36px);
    background: var(--navy);
    color: var(--white);
    border-radius: calc(var(--radius) * 1.3);
  }

  .details h2 {
    font-size: 1.35rem;
    color: var(--white);
    margin-block-end: 20px;
  }

  .details ul {
    display: grid;
    gap: 18px;
    list-style: none;
  }

  .details li {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .details__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgb(0 74 173 / 40%);
    color: #8db8ff;
  }

  .details li div {
    display: grid;
  }

  .details li div span {
    font-size: 0.85rem;
    color: var(--muted-on-dark);
  }

  .details a {
    color: var(--white);
    font-weight: 600;
    text-decoration: none;
  }

  [dir='rtl'] .details a[dir='ltr'] {
    text-align: right;
  }

  .details a:hover {
    text-decoration: underline;
  }

  .details strong {
    font-weight: 600;
  }

  .map {
    width: 100%;
    height: 240px;
    margin-block-start: 24px;
    border: 0;
    border-radius: var(--radius);
    background: var(--navy-2);
  }
</style>

<script>
  // Preselect the enquiry type from ?type=... (used by company pages).
  const type = new URLSearchParams(window.location.search).get('type');
  const select = document.querySelector<HTMLSelectElement>('#contact-type');
  if (type && select && [...select.options].some((o) => o.value === type)) select.value = type;
</script>
