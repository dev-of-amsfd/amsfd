---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Stripes from '../components/Stripes.astro';
import SectionHead from '../components/SectionHead.astro';
import CompanyCard from '../components/CompanyCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { home, pillars, sectors } from '../data/content';
import { companies } from '../data/companies';
import { href, type Lang } from '../i18n/routes';
import { useUi } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = home[lang];
const t = useUi(lang);
---

<Base lang={lang} title={c.title} description={c.description} route="home">
  <section class="hero">
    <Stripes />
    <img class="hero__mark" src="/images/brands/amsc-mark-white.png" alt="" width="510" height="442" />
    <div class="container">
      <div class="hero__inner">
      <span class="eyebrow">{c.eyebrow}</span>
      <h1>{c.heading}</h1>
      <p class="hero__lead">{c.lead}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={href(lang, 'about')}>{c.heroPrimary}<Icon name="arrow" class="icon--dir" /></a>
        <a class="btn btn--ghost-light" href={href(lang, 'contact')}>{c.heroSecondary}</a>
      </div>
      </div>
    </div>
    <div class="container">
      <dl class="stats">
        {
          c.stats.map((s) => (
            <div class="stat">
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container split split--start">
      <div>
        <span class="eyebrow">{c.aboutEyebrow}</span>
        <h2 class="h2">{c.aboutHeading}</h2>
        <p class="lead about-text">{c.aboutText}</p>
        <a class="text-link" href={href(lang, 'about')}>{t.readMore}<Icon name="arrow" class="icon--dir" /></a>
      </div>
      <div class="grid pillars">
        {
          pillars[lang].map((p) => (
            <div class="card card--accent">
              <div class="card__icon"><Icon name={p.icon} /></div>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <SectionHead eyebrow={c.companiesEyebrow} heading={c.companiesHeading} lead={c.companiesLead} />
      <div class="grid grid--3">
        {companies.map((co) => <CompanyCard company={co} lang={lang} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead eyebrow={c.sectorsEyebrow} heading={c.sectorsHeading} />
      <div class="grid grid--3">
        {
          sectors[lang].map((s) => (
            <a class="card card--link sector" href={`${href(lang, 'sectors')}#${s.id}`}>
              <div class="card__icon"><Icon name={s.icon} /></div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--dark why">
    <div class="container">
      <SectionHead eyebrow={c.whyEyebrow} heading={c.whyHeading} />
      <ol class="why__list">
        {
          c.why.map((w, i) => (
            <li>
              <span class="why__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand
    heading={c.ctaHeading}
    text={c.ctaText}
    primary={{ label: c.ctaButton, href: href(lang, 'contact') }}
    secondary={{ label: c.ctaSecondary, href: href(lang, 'partnerships') }}
  />
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(72px, 11vw, 140px) 0;
    background: var(--navy);
    color: var(--white);
    isolation: isolate;
  }

  .hero__mark {
    position: absolute;
    z-index: -1;
    inset-block-start: 12%;
    inset-inline-end: 6%;
    width: min(38vw, 440px);
    opacity: 0.08;
  }

  .hero__inner {
    max-width: 860px;
  }

  .hero h1 {
    font-size: var(--fs-hero);
    line-height: 1.2;
    color: var(--white);
  }

  .hero__lead {
    max-width: 640px;
    margin-block: 22px 34px;
    font-size: var(--fs-lead);
    color: var(--muted-on-dark);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: clamp(56px, 8vw, 96px) 0 0;
    border-block-start: 1px solid rgb(255 255 255 / 12%);
  }

  @media (min-width: 800px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    padding: 26px 0;
    padding-inline-end: 16px;
  }

  .stat + .stat {
    padding-inline-start: 20px;
    border-inline-start: 1px solid rgb(255 255 255 / 12%);
  }

  @media (max-width: 799px) {
    .stat:nth-child(3) {
      padding-inline-start: 0;
      border-inline-start: 0;
    }
    .stat:nth-child(n + 3) {
      border-block-start: 1px solid rgb(255 255 255 / 12%);
    }
  }

  .stat dd {
    margin: 0;
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--white);
  }

  .stat dt {
    color: var(--muted-on-dark);
    font-size: 0.95rem;
  }

  .h2 {
    font-size: var(--fs-h2);
  }

  .about-text {
    margin-block: 18px 22px;
  }

  .pillars {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }

  .sector {
    text-decoration: none;
    color: inherit;
  }

  .why__list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 860px) {
    .why__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .why__list li {
    padding: 28px 0;
    border-block-start: 1px solid rgb(255 255 255 / 14%);
  }

  @media (min-width: 860px) {
    .why__list li {
      padding: 32px 28px 8px;
      border-block-start: 0;
      border-inline-start: 1px solid rgb(255 255 255 / 14%);
    }
    .why__list li:first-child {
      padding-inline-start: 0;
      border-inline-start: 0;
    }
  }

  .why__num {
    display: block;
    margin-block-end: 14px;
    font-size: 0.95rem;
    font-weight: 700;
    color: #6fa3ff;
  }

  .why h3 {
    font-size: 1.3rem;
    margin-block-end: 10px;
  }

  .why p {
    color: var(--muted-on-dark);
  }
</style>
