# Hostinger (LiteSpeed/Apache) settings for the static amsc.sa site.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and the bare domain.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://amsc.sa%{REQUEST_URI} [L,R=301]

  # Old WordPress URLs -> new pages.
  RewriteRule ^about-us/?$ /about/ [L,R=301]
  RewriteRule ^contact-us/?$ /contact/ [L,R=301]
  RewriteRule ^our-services/?$ /sectors/ [L,R=301]
  RewriteRule ^our-specialist/?$ /about/ [L,R=301]
  RewriteRule ^en/about-us/?$ /en/about/ [L,R=301]
  RewriteRule ^en/contact-us/?$ /en/contact/ [L,R=301]
  RewriteRule ^en/our-services/?$ /en/sectors/ [L,R=301]
  RewriteRule ^en/our-specialist/?$ /en/about/ [L,R=301]
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|feed|comments/feed)(/.*)?$ / [L,R=301]

  # Add the trailing slash the site uses (e.g. /about -> /about/).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_FILENAME}/ -d
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml image/svg+xml
</IfModule>
